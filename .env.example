# Telegram bot token from @BotFather
BOT_TOKEN=
# OpenRouter API key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
# OpenRouter model id, e.g. openai/gpt-4o-mini, anthropic/claude-3.5-haiku, meta-llama/llama-3.3-70b-instruct
LLM_MODEL=openai/gpt-4o-mini
# Preferred transcript languages, comma-separated, in priority order
TRANSCRIPT_LANGS=en
# Max transcript chars sent to the LLM (rest is truncated)
MAX_TRANSCRIPT_CHARS=12000
